<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent for the periodic dependabot-escalate sweep (2026-08-04).

  Do not edit this file directly — tokens are substituted by install-dependabot-escalate.sh.

  Instructions:
    Run: bash plugins/dev/scripts/install-dependabot-escalate.sh
    (called automatically by 'catalyst-stack install-services' / 'uninstall-services')

  Manual steps (if needed):
    1. Copy to ~/Library/LaunchAgents/ai.coalesce.catalyst-dependabot-escalate.plist
    2. Replace REPLACE_WITH_ABSOLUTE with the absolute path to the scripts dir
       (e.g. /Users/you/catalyst/plugin-source/plugins/dev/scripts)
    3. Replace REPLACE_HOME with your absolute home directory (e.g. /Users/you)
    4. Replace REPLACE_START_INTERVAL with the interval in seconds (e.g. 3600)
    5. Replace REPLACE_PATH with a PATH string that includes jq/gh/linearis/node
    6. Replace REPLACE_CONFIG with the absolute path to your repo/team config
       (e.g. /Users/you/.config/catalyst/dependabot-escalate-repos.json)
    7. Load:
         launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/ai.coalesce.catalyst-dependabot-escalate.plist
    8. Verify:
         launchctl list | grep dependabot-escalate
         tail -f ~/catalyst/dependabot-escalate.log

  To unload:
    bash plugins/dev/scripts/install-dependabot-escalate.sh --uninstall

  For a one-shot test run:
    bash REPLACE_WITH_ABSOLUTE/dependabot-escalate.sh --dry-run
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.coalesce.catalyst-dependabot-escalate</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>REPLACE_WITH_ABSOLUTE/dependabot-escalate.sh</string>
    <string>--lookback-hours=26</string>
  </array>

  <key>StartInterval</key>
  <integer>REPLACE_START_INTERVAL</integer>

  <key>RunAtLoad</key>
  <false/>

  <!-- launchd's default PATH omits /opt/homebrew/bin — without it gh/jq/node
       (and linearis, which lives under /opt/homebrew/bin) can't be resolved.
       DEPENDABOT_ESCALATE_CONFIG is baked in at install time (resolved from
       the installer's own env or the default path) because launchd does NOT
       inherit the installer's shell environment — a custom config path set
       only for the install invocation would otherwise silently revert to
       the default on every scheduled run. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>REPLACE_PATH</string>
    <key>DEPENDABOT_ESCALATE_CONFIG</key>
    <string>REPLACE_CONFIG</string>
  </dict>

  <key>StandardOutPath</key>
  <string>REPLACE_HOME/catalyst/dependabot-escalate.log</string>

  <key>StandardErrorPath</key>
  <string>REPLACE_HOME/catalyst/dependabot-escalate.log</string>
</dict>
</plist>
