<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent for periodic orphan sweep (CTL-694).

  Do not edit this file directly — tokens are substituted by install-orphan-sweep.sh.

  Instructions:
    Run: bash plugins/dev/scripts/install-orphan-sweep.sh
    (or it is called automatically by setup-catalyst.sh)

  Manual steps (if needed):
    1. Copy to ~/Library/LaunchAgents/ai.coalesce.catalyst-orphan-sweep.plist
    2. Replace REPLACE_WITH_ABSOLUTE with the absolute path to the scripts dir
       (e.g. /Users/you/.claude/plugins/marketplaces/catalyst/plugins/dev/scripts)
    3. Replace REPLACE_HOME with your home directory (e.g. /Users/you)
    4. Replace REPLACE_START_INTERVAL with the interval in seconds (e.g. 3600)
    5. Replace REPLACE_AGENT_PATH with a PATH that resolves `node` and `claude`
       (launchd's own default PATH omits Homebrew and ~/.local/bin — CTL-1289)
    6. Load:
         launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/ai.coalesce.catalyst-orphan-sweep.plist
    7. Verify:
         launchctl list | grep orphan-sweep
         tail -f ~/catalyst/orphan-sweep.log

  To unload:
    bash plugins/dev/scripts/install-orphan-sweep.sh --uninstall

  For a one-shot test run:
    bash REPLACE_WITH_ABSOLUTE/orphan-sweep.sh --dry-run

  See: docs/orphan-sweep.md
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.coalesce.catalyst-orphan-sweep</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>REPLACE_WITH_ABSOLUTE/orphan-sweep.sh</string>
  </array>

  <key>StartInterval</key>
  <integer>REPLACE_START_INTERVAL</integer>

  <key>RunAtLoad</key>
  <false/>

  <!--
    CTL-1531 — the vector-1 WIDENED (any-command) branch's rollout knob, shipped
    IN THE TEMPLATE so the setting actually persists.

    It lives here rather than only in orphan-sweep.sh's in-script default because
    install-orphan-sweep.sh unconditionally REGENERATES and replaces this plist on
    every routine `catalyst-stack install-services` run. A rollout flip that is
    hand-edited into the installed plist would be silently reverted by the next
    install — a knob a routine reinstall resets is worse than no knob.

    The installer therefore resolves the value, in order:
      1. an explicit SWEEP_PROC_WIDEN in the installing environment
      2. .catalyst/config.json → catalyst.sweep.procWiden
      3. the value ALREADY PRESENT in the installed plist   ← preserves a hand-flip
      4. "shadow" (ADR-023 dark-by-default)
    Anything not in off|shadow|enforce falls back to shadow.
  -->
  <!--
    CTL-1289 — without an explicit PATH, launchd runs this agent with its own
    bare default (no ~/.local/bin, no Homebrew). orphan-sweep.sh shells out to
    `claude agents --json` (its OWN liveness check — the thing that's supposed
    to stop it from flipping a genuinely-running phase signal to failed) and
    to `node` (the explanation-JSON generator for every escalation it writes).
    Both exit-127 silently under the bare PATH: the liveness check always
    reports "not live" and every escalation carries an empty `explanation: {}`.
    Mirrors catalyst-stack's _stack_agent_path — keep the two in sync.
  -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>SWEEP_PROC_WIDEN</key>
    <string>REPLACE_SWEEP_PROC_WIDEN</string>
    <key>PATH</key>
    <string>REPLACE_AGENT_PATH</string>
  </dict>

  <key>StandardOutPath</key>
  <string>REPLACE_HOME/catalyst/orphan-sweep.log</string>

  <key>StandardErrorPath</key>
  <string>REPLACE_HOME/catalyst/orphan-sweep.log</string>
</dict>
</plist>
