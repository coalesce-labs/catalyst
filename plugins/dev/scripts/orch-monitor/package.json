{
  "name": "orch-monitor",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "knip": "knip",
    "knip:ci": "knip --reporter compact",
    "audit": "bun audit",
    "check": "bun run typecheck && bun run lint && bun run knip && bun audit && bun test",
    "build:ui": "cd ui && bun run build",
    "dev:ui": "cd ui && bun run dev",
    "audit:gen": "bun run bin/gen-attribute-audit.ts",
    "gen:icons": "bun run bin/gen-phosphor-icons.ts"
  },
  "dependencies": {
    "@catalyst-cloud/read-model": "^0.1.1",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "smee-client": "^5.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.18",
    "@types/web-push": "^3.6.4",
    "eslint": "^10",
    "eslint-plugin-security": "^4.0.0",
    "globals": "^17.11.0",
    "knip": "6.32.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "8.68.0"
  }
}
