# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
.obsidian/
*.swp
*.swo
*~

# Local AI-tool state (not shared with team)
.codex/
.playwright-mcp/

# Temporary files
*.tmp
*.bak

# Workspace update metadata (tracks installation state, not source)
.claude/.workspace-metadata.json

# Backup directories created by update-project.sh
.claude-backup-*/

# HumanLayer thoughts directory (symlink to external system)
thoughts/

# Research documents belong in thoughts/shared/research/ (not in repo)
research/

# Personal developer configuration (not shared with team)
.claude/config.local.json
.claude/.personal/*
!.claude/.personal/README.md
!.claude/.personal/.gitkeep

# Workflow context (per-worktree, not shared)
.catalyst/.workflow-context.json
.catalyst/.workflow-context.json.tmp
# Deprecated locations (backward compat)
.claude/.workflow-context.json
.claude/.workflow-context.json.tmp

# Backup files from config migration
.claude/config.json.backup
.catalyst/config.json.backup

# Session state (per-session, not committed)
.catalyst/.session-id

# Machine-local sticky host identity (CTL-1093)
.catalyst/.host-identity.json

# Catalyst workflow state (per-session, not committed)
# NOTE: .catalyst/config.json is SAFE to commit (only has projectKey, no secrets)
# Secrets are stored in ~/.config/catalyst/config-*.json (never in repo)
.claude/*.local.json
.claude/*.backup
.catalyst/*.local.json
.catalyst/*.backup

# CAT-90: the per-node Claude OAuth token belongs in ~/.config/catalyst/
# claude-accounts.env, outside any repo — never inside one. Safety net only
# (this pattern can never legitimately match a tracked path): guards against
# an accidental local copy landing inside the repo tree.
claude-accounts.env

# Website build artifacts
website/node_modules/
website/dist/
website/.astro/

# Plugin-local tooling (orch-monitor)
plugins/dev/scripts/orch-monitor/node_modules/

# Plugin-local tooling (event-mirror, CTL-1654)
plugins/dev/scripts/event-mirror/node_modules/
plugins/dev/scripts/event-mirror/bun.lock

# Serena (code-understanding MCP): version project.yml + memories/, ignore per-machine cache/overrides
.serena/cache/
.serena/project.local.yml
.serena/logs/

# mockups/ and docs/specs/: HTML mockups are reviewed source and stay tracked;
# the screenshots captured while iterating on them are ephemeral and don't
# belong in history. New design work lives under docs/specs/ (see its README).
mockups/**/*.png
docs/specs/**/*.png

# Ad hoc root-level package install (e.g. `npm install linearis` for local CLI use)
/node_modules/

# turbo (CTL-1628): per-task run logs/cache, written under each workspace member
# and at the repo root whenever `turbo run <task>` executes.
.turbo/

# Worktree-safety machine-local noise marker (see MACHINE_LOCAL_NOISE in
# plugins/dev/scripts/execution-core/worktree-safety.mjs)
.orphaned_at

# CAT-251: `gh` resolves ${XDG_STATE_HOME:-$HOME/.local/state} to a RELATIVE path when HOME is
# unset, so any test-spawned `gh` (even `gh --version`) writes .local/state/gh/device-id under the
# process cwd. Root-anchored: this must never shadow a package-local .local/ someone adds later.
/.local/
# ...and the same artifact at DEPTH: workflows run tests from several nested working directories,
# so the root anchor above covers only one of them. Scoped to the gh state dir specifically — a
# bare `**/.local/` would ignore unrelated package-local content. Pinned by
# plugins/dev/scripts/execution-core/gh-state-ignore-guard.test.mjs.
**/.local/state/gh/
